# Copy this file to `.env` and fill it in ON YOUR OWN PC. Never commit `.env` or paste it in chat.
#
# MetaTrader 5 credentials are optional here: you can also type them into the
# control panel (`python -m tulipai panel`), or leave them empty to use the
# account already logged in (with "Save password") inside the MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe if MT5 is not in the default install location, e.g.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# Claude API key for the AI decision layer (https://console.anthropic.com).
# Leave empty to run quant-only (ai.mode: off).
ANTHROPIC_API_KEY=
